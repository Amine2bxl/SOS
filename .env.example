# Variables à définir dans Vercel (Settings → Environment Variables).
# Ces deux clés sont publiques : elles sont destinées au navigateur et la
# sécurité repose sur les politiques RLS de la base, pas sur leur secret.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# Sans ces variables, le site public fonctionne normalement ;
# seuls les comptes et le tableau de bord affichent un message d'indisponibilité.
