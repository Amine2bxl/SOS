# ─────────────────────────────────────────────────────────────────────────────
# Variables à définir dans Vercel (Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────────────────────

# PUBLIQUES — destinées au navigateur. La sécurité repose sur les politiques
# RLS de la base, pas sur leur secret.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx

# URL réelle du site. Sert aux liens et au logo des e-mails.
NEXT_PUBLIC_SITE_URL=https://sos-citizens.be

# SECRÈTES — jamais exposées au navigateur, jamais commitées.
# Supabase → Project Settings → API → service_role. Sert uniquement à produire
# nous-mêmes le code de confirmation à 6 chiffres, sans e-mail Supabase.
SUPABASE_SERVICE_ROLE_KEY=

# resend.com → API Keys. Sans elle, le site retombe sur l'e-mail de
# confirmation générique de Supabase (limité, non personnalisé).
RESEND_API_KEY=

# Adresse d'expédition, sur un domaine vérifié dans Resend.
EMAIL_EXPEDITEUR="SOS Citizens ASBL <bonjour@sos-citizens.be>"

# Sans NEXT_PUBLIC_SUPABASE_*, le site public fonctionne normalement ;
# seuls les comptes et le tableau de bord affichent un message d'indisponibilité.
